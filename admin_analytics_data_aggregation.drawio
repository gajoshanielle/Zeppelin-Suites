<mxfile host="app.diagrams.net" modified="2026-11-08T11:12:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="admin-analytics-aggregation" name="Admin Analytics Data Aggregation">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Zeppelin Suites - Admin Analytics Data Aggregation Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="610" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Start -->
        <mxCell id="node_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="365" y="70" width="120" height="45" as="geometry" />
        </mxCell>

        <!-- 2. Admin Login & Access -->
        <mxCell id="node_login" value="Admin logs in and accesses&#xa;Analytics &amp; Overview Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;fontColor=#7f1d1d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="315" y="145" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- 3. Input: Select Filters -->
        <mxCell id="node_input" value="Select Reporting Parameters&#xa;(Reporting Month/Year, Date Range, Unit Type Filter)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="225" width="330" height="55" as="geometry" />
        </mxCell>

        <!-- 4. Query Raw Data -->
        <mxCell id="node_db" value="Fetch Raw Transaction Records from Database:&#xa;• units_table (occupancy status)&#xa;• reservation_table (payments &amp; lease values)&#xa;• maintenance_table (repair logs)&#xa;• inquiry_table (leads &amp; conversions)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="270" y="310" width="310" height="95" as="geometry" />
        </mxCell>

        <!-- 5. Data Processing Phase -->
        <mxCell id="node_processing" value="DATA PROCESSING PHASE&#xa;(Filter verified transactions within date range,&#xa;group records by day/month, and validate active units)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;fontColor=#7f1d1d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="435" width="310" height="60" as="geometry" />
        </mxCell>

        <!-- 6. Data Aggregation Phase -->
        <mxCell id="node_aggregation" value="DATA AGGREGATION PHASE&#xa;(Executes Statistical Math &amp; SQL Formulas)&#xa;&#xa;1. Occupancy Rate: ((Occupied + Reserved) / Total Units) * 100&#xa;2. Total Revenue: SUM(required_amount) for Verified Sales&#xa;3. Category Split: Leasing vs. Resale Revenue Breakdown&#xa;4. Daily Time-Series: Daily counts (DAY 1..31) for Chart.js&#xa;5. Pending Alerts: Total pending tasks across all modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=left;spacingLeft=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="525" width="370" height="130" as="geometry" />
        </mxCell>

        <!-- 7. Decision: Records Exist? -->
        <mxCell id="node_decision" value="Are aggregated&#xa;results available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="685" width="170" height="85" as="geometry" />
        </mxCell>

        <!-- 7a. No Records -->
        <mxCell id="node_empty" value="Display Zero States&#xa;(0% Occupancy, ₱0.00 Sales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="795" width="190" height="45" as="geometry" />
        </mxCell>

        <!-- 7b. Format Results -->
        <mxCell id="node_format" value="Format Metrics &amp; Percentages&#xa;(Currency format, rounded %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="795" width="190" height="45" as="geometry" />
        </mxCell>

        <!-- 8. Output Visual Analytics -->
        <mxCell id="node_output" value="RENDER ANALYTICS DASHBOARD&#xa;• Summary KPI Cards (Total Units, Sales, Pending Tasks)&#xa;• Interactive Chart.js Graphs (Trends, Revenue, Occupancy)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="875" width="370" height="60" as="geometry" />
        </mxCell>

        <!-- 9. End -->
        <mxCell id="node_end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="365" y="965" width="120" height="45" as="geometry" />
        </mxCell>

