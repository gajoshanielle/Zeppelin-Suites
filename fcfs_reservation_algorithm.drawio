<mxfile host="app.diagrams.net" modified="2026-11-08T12:35:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="fcfs-general-with-alternatives" name="FCFS Reservation Algorithm">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="title" value="Zeppelin Suites - First-Come, First-Served (FCFS) Reservation Algorithm" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="85" y="15" width="750" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="General Algorithm Flowchart for Unit Allocation, Collision Prevention &amp; Alternative Unit Redirection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="85" y="42" width="750" height="20" as="geometry" />
        </mxCell>

        <!-- 1. Start -->
        <mxCell id="node_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="80" width="130" height="42" as="geometry" />
        </mxCell>

        <!-- 2. Client Submission -->
        <mxCell id="node_submit" value="Client Submits Reservation Request&#xa;(Selects target unit, dates, and submits payment proof)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="275" y="150" width="360" height="55" as="geometry" />
        </mxCell>

        <!-- 3. Decision 1: Is Target Unit Available? -->
        <mxCell id="node_check_avail" value="Is the target unit&#xa;available for the&#xa;requested dates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="190" height="85" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- NEW FEATURE: ALTERNATIVE APPROVED UNITS CHECK  -->
        <!-- ============================================== -->

        <!-- 3a. Decision: Are other approved units available? -->
        <mxCell id="node_check_others" value="Are there any other&#xa;approved / suggested&#xa;units available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="180" height="85" as="geometry" />
        </mxCell>

        <!-- 3a-1. Branch Yes: Redirect to Select Alternative -->
        <mxCell id="node_redirect" value="Redirect Client to Alternative Unit:&#xa;Select another unit approved by owners&#xa;from reservation dropdown options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1d4ed8;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="150" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- 3a-2. Branch No: Reject Request -->
        <mxCell id="node_blocked" value="Reject Reservation Request:&#xa;Notify client that no approved&#xa;units are currently available" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="220" height="58" as="geometry" />
        </mxCell>

        <!-- End Blocked -->
        <mxCell id="node_end_blocked" value="END&#xa;(Request Blocked)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=#b91c1c;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="565" width="140" height="38" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- SUCCESSFUL FLOW: HOLD, VERIFY, CONFIRM         -->
        <!-- ============================================== -->

        <!-- 4. Place Unit On Hold -->
        <mxCell id="node_hold" value="Place Unit &quot;On Hold&quot;:&#xa;• Unit current status updated to 'On Hold'&#xa;• Calendar dates temporarily blocked for this client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#3b0764;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="310" height="60" as="geometry" />
        </mxCell>

        <!-- 5. Admin / Owner Verification -->
        <mxCell id="node_verify" value="Admin / Owner Verifies:&#xa;Submitted payment proof &amp; required documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="310" height="50" as="geometry" />
        </mxCell>

        <!-- 6. Decision 2: Payment Approved? -->
        <mxCell id="node_check_pay" value="Is payment &amp;&#xa;documentation&#xa;approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="530" width="190" height="85" as="geometry" />
        </mxCell>

        <!-- 6a. Branch No: Release Hold -->
        <mxCell id="node_release" value="Release Hold on Unit:&#xa;• Unit reverts to 'Ready for Occupancy'&#xa;• Unit becomes available for subsequent applicants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#991b1b;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="540" width="250" height="65" as="geometry" />
        </mxCell>

        <!-- End Release -->
        <mxCell id="node_end_release" value="END&#xa;(Reservation Cancelled)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="665" y="635" width="150" height="38" as="geometry" />
        </mxCell>

        <!-- 6b. Branch Yes: Lock Resource -->
        <mxCell id="node_lock" value="Lock Unit Resource (FCFS Confirmed):&#xa;• Unit status updated to 'Reserved' / 'Occupied'&#xa;• Permanent date range lock in reservation table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="290" y="645" width="330" height="65" as="geometry" />
        </mxCell>

        <!-- 7. Confirmation Output -->
        <mxCell id="node_confirm" value="Issue Official Confirmation:&#xa;Generate lease record &amp; send confirmation to client" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="735" width="330" height="50" as="geometry" />
        </mxCell>

        <!-- End Success -->
        <mxCell id="node_end_success" value="END&#xa;(Reservation Confirmed)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="815" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- General Principle Note Box -->
        <mxCell id="legend_box" value="General FCFS Principle:&#xa;• Only 1 client can hold a unit at any time.&#xa;• Earliest submission claims the 'On Hold' lock.&#xa;• If a unit collision occurs, applicant can choose&#xa;  from other owner-approved units.&#xa;• Released holds immediately reopen unit to pool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#475569;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="255" height="95" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- CONNECTORS / FLOW EDGES                        -->
        <!-- ============================================== -->

        <!-- Start -> Submit -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="node_start" target="node_submit"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Submit -> Check Avail -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="node_submit" target="node_check_avail"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Avail -> No (Taken / Collision) -> Check Others -->
        <mxCell id="e3_no" value="No (Collision / Taken)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_check_avail" target="node_check_others">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="282" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Check Others -> Yes -> Redirect to Alternative -->
        <mxCell id="e_others_yes" value="Yes (Other Units Available)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563eb;fontStyle=1;fontColor=#1d4ed8;" edge="1" parent="1" source="node_check_others" target="node_redirect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redirect -> Loop back to Submit -->
        <mxCell id="e_redirect_submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="1" source="node_redirect" target="node_submit"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Others -> No -> Blocked -->
        <mxCell id="e_others_no" value="No (None Available)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_check_others" target="node_blocked"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Blocked -> End Blocked -->
        <mxCell id="e_blocked_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;" edge="1" parent="1" source="node_blocked" target="node_end_blocked"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Avail -> Yes (Available) -> Hold -->
        <mxCell id="e3_yes" value="Yes (Available)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_check_avail" target="node_hold"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Hold -> Verify -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8b5cf6;" edge="1" parent="1" source="node_hold" target="node_verify"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Verify -> Check Pay -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="node_verify" target="node_check_pay"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Pay -> No (Declined / Cancelled) -> Release -->
        <mxCell id="e6_no" value="No (Declined / Cancelled)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_check_pay" target="node_release">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="572" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Release -> End Release -->
        <mxCell id="e_release_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#94a3b8;" edge="1" parent="1" source="node_release" target="node_end_release"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Pay -> Yes (Approved) -> Lock -->
        <mxCell id="e6_yes" value="Yes (Approved)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_check_pay" target="node_lock"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lock -> Confirm -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="node_lock" target="node_confirm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Confirm -> End Success -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="node_confirm" target="node_end_success"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
