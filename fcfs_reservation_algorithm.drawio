<mxfile host="app.diagrams.net" modified="2026-11-08T14:20:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="fcfs-super-simple" name="FCFS Process (Simple)">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Zeppelin Suites - First-Come, First-Served (FCFS) Reservation Process" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="75" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Start -->
        <mxCell id="step_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="130" height="45" as="geometry" />
        </mxCell>

        <!-- 2. Pick Unit -->
        <mxCell id="step_pick" value="Client selects a target unit&#xa;and preferred move-in dates" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="285" y="155" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- 3. Diamond: Is unit free? -->
        <mxCell id="step_check_free" value="Is the unit free&#xa;on those dates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="335" y="245" width="180" height="85" as="geometry" />
        </mxCell>

        <!-- 4a. Left: Diamond: Other units? -->
        <mxCell id="step_other_units" value="Are other units&#xa;available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="170" height="85" as="geometry" />
        </mxCell>

        <!-- 4b. Rejection -->
        <mxCell id="step_reject" value="Booking Rejected:&#xa;Unit is taken and no other&#xa;units are available" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- End Rejected -->
        <mxCell id="step_end_reject" value="END&#xa;(Request Closed)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=#b91c1c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="565" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- 5. Unit On Hold -->
        <mxCell id="step_hold" value="Put unit &quot;ON HOLD&quot;&#xa;(Locked so no one else can take it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#3b0764;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="365" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- 6. Diamond: Did client pay? -->
        <mxCell id="step_check_pay" value="Did client pay deposit&#xa;&amp; submit requirements?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="455" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- 7a. Payment NO: Cancel hold -->
        <mxCell id="step_cancel" value="Hold is CANCELLED:&#xa;Unit becomes free again for&#xa;the next person in line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#991b1b;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- End Cancel -->
        <mxCell id="step_end_cancel" value="END&#xa;(Hold Dropped)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="565" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- 7b. Payment YES: Officially Reserved -->
        <mxCell id="step_reserved" value="Unit is Officially RESERVED!&#xa;(Lease confirmed &amp; key assigned)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="585" width="250" height="65" as="geometry" />
        </mxCell>

        <!-- 8. End Success -->
        <mxCell id="step_end_success" value="SUCCESS&#xa;(Reservation Complete)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="685" width="190" height="45" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- CONNECTORS                                     -->
        <!-- ============================================== -->

        <!-- Start -> Pick -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="step_start" target="step_pick"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Pick -> Check Free -->
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="step_pick" target="step_check_free"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Free -> NO (Taken) -> Check other units -->
        <mxCell id="c_free_no" value="NO (Taken)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;" edge="1" parent="1" source="step_check_free" target="step_other_units">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="287" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Other units -> YES -> Loop back to Pick Unit -->
        <mxCell id="c_other_yes" value="YES (Pick another unit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563eb;fontColor=#1d4ed8;fontStyle=1;" edge="1" parent="1" source="step_other_units" target="step_pick">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="182" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Other units -> NO -> Reject -->
        <mxCell id="c_other_no" value="NO (None left)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;" edge="1" parent="1" source="step_other_units" target="step_reject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_reject_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;" edge="1" parent="1" source="step_reject" target="step_end_reject"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Free -> YES (Free) -> Hold -->
        <mxCell id="c_free_yes" value="YES (Free)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="step_check_free" target="step_hold"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Hold -> Check Pay -->
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="step_hold" target="step_check_pay"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Pay -> NO -> Cancel Hold -->
        <mxCell id="c_pay_no" value="NO (Didn't pay / Cancelled)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;" edge="1" parent="1" source="step_check_pay" target="step_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_cancel_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#94a3b8;" edge="1" parent="1" source="step_cancel" target="step_end_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Check Pay -> YES -> Reserved -->
        <mxCell id="c_pay_yes" value="YES (Paid &amp; Approved)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="step_check_pay" target="step_reserved"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Reserved -> Success -->
        <mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="1" source="step_reserved" target="step_end_success"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
